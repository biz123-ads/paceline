# Copy to .env.local and fill in what you want to switch on.
# Everything is optional: with nothing set, the app runs with data in the
# browser, no accounts and no assistant. docs/setup.md walks through each one.

# --- Accounts and cloud storage (Supabase) ---------------------------------
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_…) or the legacy anon key. Public by design.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key (sb_secret_…) or legacy service_role key. Server only, never
# NEXT_PUBLIC_. Needed for credits (assistant, purchases).
SUPABASE_SECRET_KEY=

# --- AI assistant (Anthropic) ----------------------------------------------
# console.anthropic.com → API keys. Needs the Supabase variables above too.
ANTHROPIC_API_KEY=

# --- Selling credit packs (Stripe, test mode is fine) ----------------------
# dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook endpoint you add in the
# dashboard for /api/stripe/webhook (event: checkout.session.completed).
STRIPE_WEBHOOK_SECRET=

# The Stripe *import* on the Data tab needs nothing here: users paste their
# own read-only key, used once and never stored.
